<Window x:Class="HelpDesk.Views.TicketEditWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="HelpDesk — Редактирование заявки" Height="540" Width="580" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <Grid Margin="22">
  <Border Background="White" CornerRadius="12" Padding="22">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="TicketNumberText" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="4,0,4,18"/>
    <StackPanel Grid.Row="1"><TextBlock Text="Категория" Margin="4,0,0,0"/><ComboBox x:Name="CategoryComboBox" Height="38">
     <ComboBoxItem Content="Оборудование"/><ComboBoxItem Content="Программное обеспечение"/><ComboBoxItem Content="Сеть"/><ComboBoxItem Content="Учётная запись"/><ComboBoxItem Content="Периферия"/><ComboBoxItem Content="Другое"/>
    </ComboBox></StackPanel>
    <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="Описание" Margin="4,0,0,0"/><TextBox x:Name="DescriptionTextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="100"/></StackPanel>
    <StackPanel Grid.Row="3"><TextBlock Text="Приоритет" Margin="4,0,0,0"/><ComboBox x:Name="PriorityComboBox" Height="38"><ComboBoxItem Content="Низкий"/><ComboBoxItem Content="Средний"/><ComboBoxItem Content="Высокий"/></ComboBox></StackPanel>
    <StackPanel Grid.Row="4"><TextBlock Text="Статус" Margin="4,0,0,0"/><ComboBox x:Name="StatusComboBox" Height="38"><ComboBoxItem Content="Новая"/><ComboBoxItem Content="В работе"/><ComboBoxItem Content="Выполнена"/><ComboBoxItem Content="Отклонена"/></ComboBox></StackPanel>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
     <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
     <Button Content="Сохранить изменения" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
