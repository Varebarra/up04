<Window x:Class="HelpDesk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk" Height="600" Width="900" MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="HelpDesk" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Система обработки заявок" FontSize="14" Opacity="0.7"/>
            </StackPanel>
            <TextBlock x:Name="CurrentUserText" Grid.Column="1" Text="Пользователь: admin"
                       FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchTextBox" Grid.Column="0" ToolTip="Введите текст для поиска"
                     TextChanged="SearchTextBox_TextChanged"/>
            <ComboBox x:Name="StatusComboBox" Grid.Column="1" SelectedIndex="0"
                      SelectionChanged="StatusComboBox_SelectionChanged">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="Новая"/>
                <ComboBoxItem Content="В работе"/>
                <ComboBoxItem Content="Выполнена"/>
                <ComboBoxItem Content="Отклонена"/>
            </ComboBox>
            <Button x:Name="SearchButton" Grid.Column="2" Content="Найти" Click="SearchButton_Click"/>
            <Button x:Name="ResetFilterButton" Grid.Column="3" Content="Сбросить" Click="ResetFilterButton_Click"/>
        </Grid>

        <DataGrid x:Name="TicketsDataGrid" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  MouseDoubleClick="TicketsDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="170"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="110"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TicketCountText" VerticalAlignment="Center" Margin="5"/>
            <Button Grid.Column="1" Content="Добавить" Click="AddTicketButton_Click"/>
            <Button Grid.Column="2" Content="Изменить" Click="EditTicketButton_Click"/>
            <Button Grid.Column="3" Content="Удалить" Click="DeleteTicketButton_Click"/>
            <Button Grid.Column="4" Content="Выйти" Click="LogoutButton_Click"/>
        </Grid>
    </Grid>
</Window>
